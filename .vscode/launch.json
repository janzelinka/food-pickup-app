{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "port": 9003,
            "pathMappings": {
                "${workspaceFolder}/app": "${workspaceFolder}/app"
            }
        },
        {
            "name": "Launch Laravel (artisan serve)",
            "type": "php",
            "request": "launch",
            "runtimeArgs": [
                "artisan",
                "serve",
                "--host=localhost",
                "--port=8000"
            ],
            "cwd": "${workspaceFolder}/app",
            "port": 9003,
            "serverReadyAction": {
                "pattern": "Development Server \\(http://localhost:8000\\)",
                "uriFormat": "http://localhost:8000",
                "action": "openExternally"
            },
            "env": {
                "XDEBUG_MODE": "debug",
                "XDEBUG_SESSION": "1"
            }
        },
        {
            "name": "Debug Current PHP Script",
            "type": "php",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}/app",
            "port": 9003
        },
        {
            "name": "Run PHPUnit Tests",
            "type": "php",
            "request": "launch",
            "program": "${workspaceFolder}/app/vendor/bin/phpunit",
            "cwd": "${workspaceFolder}/app",
            "port": 9003,
            "args": []
        }
    ]
}